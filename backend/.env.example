# ChoirIQ Backend Environment Variables
# Copy this to .env and fill in your values

PORT=3001

# REQUIRED: Your Gemini API key (get from Google AI Studio)
GEMINI_API_KEY=AIzaSyAKKBgQDKobRNMyvdPGTDRPJDtDvfRY7cE

# Optional: SQLite database file path
DB_FILE=./data/choiriq.sqlite

# JWT secret — change this to a long random string in production
JWT_SECRET=choiriq-super-secret-change-me-in-production

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

NODE_ENV=development
