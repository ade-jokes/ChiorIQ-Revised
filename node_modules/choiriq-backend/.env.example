# ChoirIQ Backend Environment Variables
# Copy this to .env and fill in your values

PORT=3001

# REQUIRED: Your Anthropic API key (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT secret — change this to a long random string in production
JWT_SECRET=choiriq-super-secret-change-me-in-production

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

NODE_ENV=development
